{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Compile",
			"type": "npm",
			"script": "compile",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": ["$tsc"]
		},
		{
			"label": "Watch",
			"type": "npm",
			"script": "watch",
			"isBackground": true,
			"problemMatcher": ["$tsc-watch"]
		},
		{
			"label": "Lint",
			"type": "npm",
			"script": "lint",
			"problemMatcher": ["$eslint-stylish"]
		},
		{
			"label": "Test",
			"type": "npm",
			"script": "test",
			"group": {
				"kind": "test",
				"isDefault": true
			}
		},
		{
			"label": "Package",
			"type": "npm",
			"script": "package"
		}
	]
}
